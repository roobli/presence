{
  "name": "i18n-slug",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Map sibling *.zh.md files to /<path>/zh, derive translation pairs, and emit language head tags",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "quartz": {
    "name": "i18n-slug",
    "displayName": "i18n slug map",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 6,
    "defaultEnabled": true,
    "defaultOptions": {}
  }
}
