---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing">
  <h1 style="font-size:1.8rem;color:var(--heading-color);margin-bottom:1.5rem;">Writing</h1>
  <ul style="list-style:none;padding:0;margin:0;display:grid;gap:1.25rem;">
    {posts.map((p) => (
      <li>
        <time class="muted" style="font-family:var(--font-ui);font-size:0.78rem;">{p.data.date.toISOString().slice(0, 10)}</time>
        <div><a href={`/writing/${p.id}`} style="color:var(--ink-strong-color);font-size:1.1rem;font-weight:600;text-decoration:none;">{p.data.title}</a></div>
        <p class="muted" style="margin:0.3rem 0 0;font-size:0.92rem;">{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>
