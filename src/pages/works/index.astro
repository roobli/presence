---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Works">
  <h1 class="text-2xl font-semibold tracking-tight mb-8">Works</h1>
  <ul class="space-y-4">
    {works.map((w) => (
      <li class="border border-[var(--border)] rounded-lg p-4">
        <a href={w.data.url} class="text-[var(--fg)] font-medium no-underline hover:underline">{w.data.title}</a>
        <p class="mt-1 text-sm text-[var(--muted)]">{w.data.description}</p>
        {w.data.repo && (
          <p class="mt-2 text-xs"><a href={w.data.repo}>repository</a></p>
        )}
      </li>
    ))}
  </ul>
</Base>
