---
import Base from '../layouts/Base.astro';
---
<Base title="About">
  <h1 class="text-2xl font-semibold tracking-tight mb-4">About</h1>
  <div class="space-y-4 text-[var(--muted)]">
    <p>
      RoobLi presence is a restrained public surface for selected works and deep writing.
      Internal notes stay internal. Published pieces live in this repository and deploy to Cloudflare Pages.
    </p>
    <p>
      GitHub: <a href="https://github.com/lr00rl">lr00rl</a> · Org: <a href="https://github.com/roobli">roobli</a>
    </p>
  </div>
</Base>
