---
import Base from '../layouts/Base.astro';
---
<Base title="About" description="About RoobLi public presence.">
  <h1 style="font-size:1.8rem;color:var(--heading-color);">About</h1>
  <div class="prose">
    <p>
      RoobLi is the public face of selected work and writing.
      Private notes (RooB) are not published from this site.
    </p>
    <p>
      This site is English-first. Some linked works — for example the
      <a href="https://lr00rl.github.io/cuda-cpp-course/">CUDA C++ Course</a> —
      ship with a Chinese track at <code>/zh/</code>. Essays here may stay English until a translation is intentional.
    </p>
    <p>
      GitHub user <a href="https://github.com/lr00rl">lr00rl</a> · org
      <a href="https://github.com/roobli">roobli</a>.
    </p>
  </div>
</Base>
