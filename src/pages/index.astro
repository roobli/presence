---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const works = (await getCollection('works'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---
<Base title="Home" description="RoobLi — restrained public presence for works and deep writing.">
  <p class="eyebrow">www.roobli.org</p>
  <h1 style="font-size:2.1rem;margin:0.6rem 0 0.8rem;color:var(--heading-color);letter-spacing:-0.02em;">
    Fewer pages. Harder claims.
  </h1>
  <p class="muted" style="font-size:1.05rem;max-width:36em;">
    RoobLi’s public surface: selected works and deep writing.
    Internal notes stay internal. Channels get excerpts, not mirrors.
  </p>

  <section style="margin-top:2.5rem;">
    <h2 class="eyebrow" style="margin-bottom:0.9rem;">Featured work</h2>
    <ul style="list-style:none;padding:0;margin:0;display:grid;gap:0.75rem;">
      {works.map((w) => (
        <li class="card">
          <a href={w.data.url} style="color:var(--ink-strong-color);font-weight:600;text-decoration:none;">{w.data.title}</a>
          <p class="muted" style="margin:0.35rem 0 0;font-size:0.92rem;">{w.data.description}</p>
          {w.data.repo && <p style="margin:0.5rem 0 0;font-size:0.8rem;font-family:var(--font-ui);"><a href={w.data.repo}>repository</a></p>}
        </li>
      ))}
    </ul>
  </section>

  <section style="margin-top:2.5rem;">
    <h2 class="eyebrow" style="margin-bottom:0.9rem;">Writing</h2>
    <ul style="list-style:none;padding:0;margin:0;display:grid;gap:1rem;">
      {posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}`} style="color:var(--ink-strong-color);font-size:1.05rem;font-weight:600;text-decoration:none;">{p.data.title}</a>
          <p class="muted" style="margin:0.3rem 0 0;font-size:0.92rem;">{p.data.description}</p>
        </li>
      ))}
    </ul>
    <p style="margin-top:1rem;font-family:var(--font-ui);font-size:0.85rem;"><a href="/writing">All writing →</a></p>
  </section>
</Base>
