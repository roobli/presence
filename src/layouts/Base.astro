---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'RoobLi presence — curated works and deep writing.' } = Astro.props;
const pageTitle = title === 'Home' ? 'RoobLi' : `${title} · RoobLi`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="antialiased">
    <div class="mx-auto max-w-2xl px-5 py-10">
      <header class="mb-12 flex items-baseline justify-between gap-4 border-b border-[var(--border)] pb-4">
        <a href="/" class="text-[var(--fg)] no-underline font-medium tracking-tight">RoobLi</a>
        <nav class="flex gap-4 text-sm text-[var(--muted)]">
          <a href="/writing" class="text-[var(--muted)] hover:text-[var(--fg)] no-underline">Writing</a>
          <a href="/works" class="text-[var(--muted)] hover:text-[var(--fg)] no-underline">Works</a>
          <a href="/about" class="text-[var(--muted)] hover:text-[var(--fg)] no-underline">About</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-16 border-t border-[var(--border)] pt-6 text-sm text-[var(--muted)]">
        One source. Cloudflare Pages. No noise.
      </footer>
    </div>
  </body>
</html>
