---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'RoobLi — public works and deep writing.' } = Astro.props;
const pageTitle = title === 'Home' ? 'RoobLi' : `${title} · RoobLi`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/works', label: 'Works' },
  { href: '/about', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('roobli-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="shell-nav">
        <a class="shell-brand" href="/">RoobLi</a>
        <nav aria-label="Primary">
          {links.map((l) => (
            <a href={l.href} aria-current={path === l.href || (l.href !== '/' && path.startsWith(l.href)) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
        <p class="muted" style="margin-top:2rem;font-size:0.78rem;line-height:1.45;">
          Org homepage. Notes stay private. One public source.
        </p>
      </aside>
      <div class="shell-main">
        <slot />
        <footer class="muted" style="margin-top:3.5rem;padding-top:1.25rem;border-top:1px solid var(--line-color);font-family:var(--font-ui);font-size:0.82rem;">
          <a href="https://github.com/roobli">github.com/roobli</a>
          · www.roobli.org
        </footer>
      </div>
    </div>
  </body>
</html>
